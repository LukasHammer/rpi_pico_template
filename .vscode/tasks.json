{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Erase Pico",
			"command": "picotool",
			"args": [
				"erase -a"
			],
			"type": "shell",
		},
        {
            "label": "Load Pico",
            "type": "shell",
            "command": "bash",
            "args": [
                "-c",
                "picotool load ${command:cmake.buildDirectory}/pico_template.uf2 && picotool reboot"
            ],
            "problemMatcher": []
        },
        {
            "label": "Pico Info",
            "command": "picotool",
            "args": [
                "info"
            ],
            "type": "shell"
        }
	]
}